{
  "//": "Committed, shared settings. Personal overrides go in settings.local.json (gitignored). The allow list is deliberately read-only tools plus this repo's own scripts. attribution.sessionUrl is false because a claude.ai session link in a commit message or PR body is permanent and removing one after the fact means rewriting published history -- that is worth avoiding in any repo. Co-Authored-By is kept.",
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",

      "Bash(devtools/devcontainer.sh:*)",
      "Bash(devtools/worktree.sh:*)",
      "Bash(devtools/doctor.sh:*)",
      "Bash(devtools/cpp-tier.sh:*)",
      "Bash(devtools/cross-backend-check.sh:*)",
      "Bash(devtools/claude-version.sh:*)",
      "Bash(docker/build.sh:*)",

      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(ninja:*)",
      "Bash(nvcc:*)",
      "Bash(hipcc:*)",
      "Bash(clang-format:*)",
      "Bash(nvidia-smi:*)",
      "Bash(rocm-smi:*)",
      "Bash(rocminfo:*)",

      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(pre-commit:*)",
      "Bash(python3 -c:*)",

      "Bash(git:*)",
      "Bash(gh:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(which:*)",
      "Bash(stat:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(getent:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker volume ls:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/session-context.sh\"; [ -f \"$SCRIPT\" ] && bash \"$SCRIPT\" || true",
            "statusMessage": "Reporting host/container + checkout"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/protect-main.py\"; [ -f \"$SCRIPT\" ] && python3 \"$SCRIPT\" || true",
            "statusMessage": "Checking main-checkout guard"
          }
        ]
      }
    ]
  }
}
